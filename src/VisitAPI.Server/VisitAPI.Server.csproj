                （QD/QROOTS/QL/BD/AD/ATPL/ABENV + 对话页退回起手模板 + 重拉素材和横幅）。
                最近列表存 pref.recent.0..4（txt 陌生顶层键会被旧版抹掉，pref 才能往返）。
                顺手修：单换任务库时漏清挂接缓存 QL。导出模组 zip 拍板不做
         1.0.0：**首个正式版**。七个模块（介绍 / BOT 服装 / 对话 / 任务 / 商人售卖 / 还原备份 /
                使用说明）齐了，986 项回归全绿，对外文档（两份 README + 两份架构说明）补齐并核对过。
                发布前把全部源码通读了一遍，修掉六个**测试全绿也照样存在**的洞：
                ① setstatus 写了个拼错的状态名 → 解析器给 -1 → DialogWriter 拿它索引 StatusNames
                   直接 IndexOutOfRange，保存/查看.dlg/挂任务当场 500。同文件的门控写手
                   Statuses() 早有这道守卫，Directives() 那行漏了
                ② 变不成模型的文件头行会被**静默删掉**：tab: always（4.0.13 写法）和写坏的 when:
                   占了头行位子却没值，回写时那条 HeadLine 返回 null → 整行从作者文件里消失，
                   不报错不警告。C# 的 when 本来有 KeepRaw、tab 没有，JS 两个都没有 → 两边补齐 + 各报一条警告
                ③ 源码窗的「下载」按钮是死的：调的 tryDownload()/fileName() 在"原型下载路径全部删除"
                   那轮就没了，按钮和接线漏删，点下去只抛 ReferenceError。连同 src_dl/saved_dl 两个键摘掉
                ④ /api/quests/links 的 Nodes() 没 try/catch，一份坏 .dlg 就能让整页挂接 500 ——
                   而兄弟调用 DlgLinks.Scan 专门为坏文件做了 broken 机制，正好被绕过
                ⑤ CustomTraders 把 `trader: "名字"`（4.0.13 不写 id 的写法）里带引号的名字当商人 id 列出来；
                   共享库 DialogHeaderParser 早有防呆，这边漏了
                ⑥ ModLooks 的类注释错挂在 ModRoot 上
                发布侧：build.ps1 还在往 0.9.9 已清退的 dist\ 出包、且不先删目录（第 8 节记着的坑），
                改成 publish\ + 先删 + 只留一个 exe；tests/README 的脚本表 25 个补齐 13 个；
                两份 README 和两份 ARCHITECTURE 补上 BOT/货架/备份/工程四个模块，
                并改掉架构文档里"将来支持编辑触发器时…"这句（0.5.0 就做了，已经是错的） -->
    <Version>1.0.0</Version>
    <!-- 构建时间写进程序集版本号（会拼成 0.1.0+b260808-0030）。
         不能靠读 exe 的文件修改时间——用户从 Release 下载后那个时间会变成下载时间，
         显示的版本就是假的，等于白做。 -->
    <SourceRevisionId>b$([System.DateTime]::UtcNow.ToString("yyMMdd-HHmm"))</SourceRevisionId>
    <!-- 分发形态：单文件 exe。framework-dependent（不自带运行时）——
         装了 SPT 的人本来就有 .NET 10 + ASP.NET Core（SPT.Server.runtimeconfig.json 写死的），
         所以不打包运行时，体积能小两个数量级。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- exe 自己的图标。同一个文件在 wwwroot 里还有一份，当网页的 favicon（见下面的嵌入规则） -->
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisitAPI.Dlg\VisitAPI.Dlg.csproj" />
    <ProjectReference Include="..\VisitAPI.Quests\VisitAPI.Quests.csproj" />
  </ItemGroup>

  <!-- 界面整包嵌进 exe：单文件分发时 wwwroot 不会自动跟着走，嵌成资源最稳 -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
