<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VisitAPI.Editor</AssemblyName>
    <RootNamespace>VisitAPI.Server</RootNamespace>
    <Version>0.5.0</Version>
    <!-- 构建时间写进程序集版本号（会拼成 0.1.0+b260808-0030）。
         不能靠读 exe 的文件修改时间——用户从 Release 下载后那个时间会变成下载时间，
         显示的版本就是假的，等于白做。 -->
    <SourceRevisionId>b$([System.DateTime]::UtcNow.ToString("yyMMdd-HHmm"))</SourceRevisionId>
    <!-- 分发形态：单文件 exe。framework-dependent（不自带运行时）——
         装了 SPT 的人本来就有 .NET 10 + ASP.NET Core（SPT.Server.runtimeconfig.json 写死的），
         所以不打包运行时，体积能小两个数量级。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- exe 自己的图标。同一个文件在 wwwroot 里还有一份，当网页的 favicon（见下面的嵌入规则） -->
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisitAPI.Dlg\VisitAPI.Dlg.csproj" />
    <ProjectReference Include="..\VisitAPI.Quests\VisitAPI.Quests.csproj" />
  </ItemGroup>

  <!-- 界面整包嵌进 exe：单文件分发时 wwwroot 不会自动跟着走，嵌成资源最稳 -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
