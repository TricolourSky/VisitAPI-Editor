<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VisitAPI.Editor</AssemblyName>
    <RootNamespace>VisitAPI.Server</RootNamespace>
    <!-- 0.6.0：新增 BOT 外观（SEC.02）和商人货架（SEC.05）两个模块 -->
    <!-- 0.6.1：这两个模块改用独立的「内容库」目录，会自动探测
         （恰好 1 个直接用 / 2 个以上弹窗挑 / 一个都没有让人自己填路径）
         0.7.0：BOT 外观界面重做 —— 顶栏选 BOT、四张部位卡、图片网格选外观、预览图
         0.8.0：BOT 服装改版 —— 左装配台/右衣柜、每个部位一个图标（原版那一池归成「默认数据」）、
                衣柜只列作者自己做的、替换写权重 1000000、恢复默认从 SPT 原版读回、
                上装与手对不上当场标红
         0.8.1：语音也纳入进来 —— 它在 bot json 里的槽和别的部位同形（id → 权重），
                所以一视同仁当第五个部位处理（左边五组、右边五个页签），不再是只读的一行
         0.8.2：保存只送**改过的那几份**。原来一股脑全送，作者改一个 BOT 就把目录里 40 份
                全重写一遍、平白留下 40 个 .bak
         0.8.3：预览图找不到「这个部位的 id」时退回「这条记录的 suiteId」——
                一件上装的身体和手出自同一条记录，作者放一张图就够（原来要放两张一样的、
                还得各自改成不同的 24 位十六进制名，全套 69 张）
         0.8.4：预览图还能按**角色名**配 —— 一个角色在数据里是三条不相干的记录
                （上衣/下装/头），没有"角色 id"把它们串起来，名字是唯一的线索。
                匹配收得很紧（整名相等，或显示名以「文件名＋一个空格」开头），
                所以 HK416.png 不会误伤 HK416YT
         0.8.5：服装卡片每列最小 200px→250px（2560 的屏上从一行 9 张变 7 张）。
                200px 时 9 列刚好卡在临界点，窗口宽一像素少一像素就跳一列
         0.8.6：修按角色名配图的两个洞 —— 比较时**忽略空格**（作者的文件叫 MG4Damage.png，
                显示名却是「MG4 Damaged JK」，原来一张都配不上）；**多个都对得上时取最长的**
                （原来战损那套会套上普通那套的图）。每张图挂 title 写明它来自哪个文件
         0.8.7：BOT 立绘也能按角色名配 —— bot 的标识是类型名（bosskilla），作者脑子里是
                角色名（Killa），所以放宽成"文件名是类型名里的一段"，同一角色的
                bosskilla / bosskillaagro 共用一张
         0.8.8：**去掉 BOT 配图**（官方没多少 BOT 立绘可放，逼作者凑图不如让这块一直显示
                真正有用的东西）。立绘窗口保留，一律画装配示意图。配图说明从「选 BOT」弹窗
