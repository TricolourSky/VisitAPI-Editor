<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SPT 任务模型 + 校验规则。只给编辑器用，不需要兼容插件，所以直接 net10.0。 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VisitAPI.Quests</AssemblyName>
    <RootNamespace>VisitAPI.Quests</RootNamespace>
  </PropertyGroup>

  <!-- 任务和对话之间那根线要读写 .dlg，所以引共享库；解析和回写都只有它一份实现 -->
  <ItemGroup>
    <ProjectReference Include="..\VisitAPI.Dlg\VisitAPI.Dlg.csproj" />
  </ItemGroup>

  <!-- 内容包的布局（什么算一个包、图片格怎么映射、版本要求怎么判）：和插件服务端共用同一份源码（它链源码编进去），只有这一处定义 -->
  <ItemGroup>
    <Compile Include="..\VisitAPI.Packs\*.cs" LinkBase="Packs" />
  </ItemGroup>

</Project>
